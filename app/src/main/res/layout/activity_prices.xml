<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/title"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Riepilogo Costi" />

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:shrinkColumns="0"
                android:stretchColumns="0">

                <TableRow
                    android:background="#EEF2F6"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/item1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Distribucion"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/value1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Mondo X Total Unid."
                        android:textAlignment="viewEnd"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mano De Obra"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/value2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Costos Producto Ingredientes Frasco"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/value3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Costos Indirectos"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/value4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5% Manejo Administrativo"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/value5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        tools:text="GANANCIAS + LOGISTICA LOCAL" />

                    <TextView
                        android:id="@+id/value6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        tools:text="TOTAL COSTO + GANANCIA" />

                    <TextView
                        android:id="@+id/value7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        tools:text="TOTAL + COMISION" />

                    <TextView
                        android:id="@+id/value8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        tools:text="10% DE VENTAS LOCALES AL DETAL" />

                    <TextView
                        android:id="@+id/value9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <View
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TableRow
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/item10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="15sp"
                        tools:text="TOTAL + COMISION + AL DETAL" />

                    <TextView
                        android:id="@+id/value10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

                <TableRow
                    android:layout_marginTop="8dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/itemTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/valueTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAlignment="viewEnd"
                        android:textColor="#0369A1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="$ 0.00" />
                </TableRow>

            </TableLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>